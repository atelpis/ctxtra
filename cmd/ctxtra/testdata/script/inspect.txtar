# files, show and explain describe what a session in a folder gets, without
# running any agent.

gitrepo dev/svc https://github.com/acme/svc
gitrepo dev/other https://github.com/acme/other

exec ctxtra context files dev/svc
stdout '/ctx/svc.md'
stdout 'deploy'
! stdout 'other.md'

exec ctxtra context show dev/svc
stdout '^Contents of .*/ctx/svc.md \(instructions added by ctxtra for this repository, ~/dev/svc, and all its worktrees; binding: svc '
stdout '^CTXMARK-SVC$'
stdout '<location>.*/skills/deploy/SKILL.md</location>'

exec ctxtra context explain dev/other
stdout '^- svc \(~/.config/ctxtra/b.yaml\): repos do not match github.com/acme/other'
stdout '^\+ other \(~/.config/ctxtra/b.yaml\): repos remote github.com/acme/other$'
stdout '^total: 1 files, 0 skills'

exec ctxtra context files dev/other
stdout '/ctx/other.md'
! stdout 'svc.md'

# A file over budget.max-chars doesn't reach the session: each command says so
# and exits with 1.
env CTXTRA_CONFIG=$HOME/budget.yaml
! exec ctxtra context files dev/svc
stderr '^dropped \(over budget.max-chars\): .*/ctx/svc.md$'
! exec ctxtra context files --json dev/svc
stdout 'dropped \(over budget.max-chars\)'
! exec ctxtra context show dev/svc
stderr '^dropped \(over budget.max-chars\): .*/ctx/svc.md$'
! exec ctxtra context explain dev/svc
stdout 'dropped .*/ctx/svc.md \(over budget.max-chars\)'
! exec ctxtra doctor dev/svc
stdout 'DROPPED \(over budget.max-chars\): .*/ctx/svc.md'
env CTXTRA_CONFIG=

# doctor checks the bindings that don't match its folder too. The context
# commands report only what a session in the folder gets.
exec ctxtra doctor dev/svc
env CTXTRA_CONFIG=$HOME/broken.yaml
! exec ctxtra doctor dev/svc
stdout 'PROBLEM: other \(~/broken.yaml\): missing: .*/ctx/gone.md'
stdout 'PROBLEM: other \(~/broken.yaml\): missing: .*/skills/gone/SKILL.md'
stdout 'PROBLEM: other \(~/broken.yaml\): .*/skills/broken/SKILL.md: .*; skipped'
! stdout 'MISSING'
! exec ctxtra doctor --json dev/svc
stdout '"severity": "error",\s+"message": "other \(~/broken.yaml\): missing: .*/ctx/gone.md"'
exec ctxtra context files dev/svc
! stderr .
env CTXTRA_CONFIG=

-- broken.yaml --
schema: ctxtra/v1
bindings:
  - name: svc
    match:
      repos:
        - remote: github.com/acme/svc
    instructions: [ctx/svc.md]
  - name: other
    match:
      repos:
        - remote: github.com/acme/other
    instructions: [ctx/other.md, ctx/gone.md]
    skills: [skills/gone, skills/broken]
-- skills/broken/SKILL.md --
---
description: [
---
-- budget.yaml --
schema: ctxtra/v1
budget:
  max-chars: 5
bindings:
  - name: me
    match:
      global: true
    instructions: [ctx/svc.md]
-- .config/ctxtra/config.yaml --
schema: ctxtra/v1
include: [b.yaml]
-- .config/ctxtra/b.yaml --
schema: ctxtra/v1
bindings:
  - name: svc
    match:
      repos:
        - remote: github.com/acme/svc
    instructions: [~/ctx/svc.md]
    skills: [~/skills/deploy]
  - name: other
    match:
      repos:
        - remote: github.com/acme/other
    instructions: [~/ctx/other.md]
-- ctx/svc.md --
CTXMARK-SVC
-- ctx/other.md --
CTXMARK-OTHER
-- skills/deploy/SKILL.md --
---
description: Deploy the service.
---

Steps.
