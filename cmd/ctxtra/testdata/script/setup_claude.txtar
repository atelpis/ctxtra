# setup adds ctxtra's hooks after another tool's, keeps the rest of the
# file, is idempotent, backs up what it changes, and --remove restores the
# original file. Claude gets 40 hooks per event, one per part of the text.

exec ctxtra setup --dry-run --agent claude
stdout '^Setup would change these files:$'
cmp .claude/settings.json original.json

exec ctxtra setup --agent claude
stdout '^ctxtra is set up for Claude Code:$'
cp .claude/settings.json got.json
slots got.json
cmpenv got.json want.json
exists .ctxtra/backups

exec ctxtra setup --agent claude
stdout 'is already set up for'

exec ctxtra doctor
stdout 'claude: set up for \[SessionStart SubagentStart\], runs .*/ctxtra \(ok\)'
! stdout 'of the 40 ctxtra hooks'
! stderr .

exec ctxtra setup --remove --agent claude
stdout '^ctxtra is removed from Claude Code:$'
cmp .claude/settings.json original.json

exec ctxtra setup --remove --agent claude
stdout 'isn''t set up for'

-- .claude/settings.json --
{
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "other-tool session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ]
  }
}
-- original.json --
{
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "other-tool session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ]
  }
}
-- want.json --
{
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "other-tool session-start"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'f=\"${BIN}\"; if [ -x \"${$}f\" ]; then exec \"${$}f\" hook claude SessionStart --slot 0 --of 40; else /bin/cat >/dev/null 2>&1; echo \"{\\\"systemMessage\\\":\\\"ctxtra: the ctxtra binary that this hook runs is missing; reinstall ctxtra, or run ctxtra setup --agent claude with the new binary\\\"}\"; fi'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'f=\"${BIN}\"; if [ -x \"${$}f\" ]; then exec \"${$}f\" hook claude SessionStart --slot 1..39 --of 40; else /bin/cat >/dev/null 2>&1; echo \"{}\"; fi'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'f=\"${BIN}\"; if [ -x \"${$}f\" ]; then exec \"${$}f\" hook claude SubagentStart --slot 0..39 --of 40; else /bin/cat >/dev/null 2>&1; echo \"{}\"; fi'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
