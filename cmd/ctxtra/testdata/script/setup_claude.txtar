# setup adds ctxtra's hooks after another tool's, keeps the rest of the
# file, is idempotent, backs up what it changes, and --remove restores the
# original file. Claude gets 40 hooks per event, one per part of the text.

exec ctxtra setup --dry-run --agent claude
stdout '^ctxtra setup \(claude\): would change$'
cmp .claude/settings.json original.json

exec ctxtra setup --agent claude
stdout '^ctxtra setup \(claude\): changed$'
stdout '^hooks run '$BIN'$'
cp .claude/settings.json got.json
slots got.json
cmpenv got.json want.json
exists .ctxtra/backups

exec ctxtra setup --agent claude
stdout 'nothing to change'

exec ctxtra doctor
stdout 'claude: set up for \[SessionStart SubagentStart\], runs .*/ctxtra \(ok\)'
! stdout 'of the 40 ctxtra hooks'

exec ctxtra setup --remove --agent claude
stdout '^ctxtra setup --remove \(claude\): changed$'
cmp .claude/settings.json original.json

exec ctxtra setup --remove --agent claude
stdout 'nothing to change'

# The single hook of an older version: doctor asks for setup, which puts
# the 40 hooks in its place.
expand single.json .claude/settings.json
! exec ctxtra doctor
stdout 'SessionStart: 0 of the 40 ctxtra hooks \(run ctxtra setup\)'
exec ctxtra setup --agent claude
stdout '^ctxtra setup \(claude\): changed$'
cp .claude/settings.json got.json
slots got.json
cmpenv got.json want.json

-- .claude/settings.json --
{
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "other-tool session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ]
  }
}
-- original.json --
{
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "other-tool session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ]
  }
}
-- want.json --
{
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "other-tool session-start"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'f=\"${BIN}\"; if [ -x \"${$}f\" ]; then exec \"${$}f\" hook claude SessionStart --slot 0..39; else /bin/cat >/dev/null 2>&1; echo \"{}\"; fi'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'f=\"${BIN}\"; if [ -x \"${$}f\" ]; then exec \"${$}f\" hook claude SubagentStart --slot 0..39; else /bin/cat >/dev/null 2>&1; echo \"{}\"; fi'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
-- single.json --
