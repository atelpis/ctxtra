# The hook never breaks a session: a missing file, a broken config or a
# missing binary still give the agent a valid answer and exit 0.

exec ctxtra setup --agent claude

# A missing bound file is skipped and reported to the user.
runhook claude SessionStart notes
stdout 'CTXMARK-PERSONAL'
stdout '"systemMessage":"✓ ctxtra added 2 instructions; 1 not found \(run ctxtra doctor\)\\nInstructions:\\n- me.md\\n- notes.md"'
stderr 'ctxtra: bound file not found: .*/ctx/gone.md'

# Outside git, repos don't match; global and dirs do.
stdout 'CTXMARK-NOTES'
! stdout 'CTXMARK-REPO'

# A config with a wrong schema adds nothing.
cp broken.yaml .config/ctxtra/config.yaml
runhook claude SessionStart notes
! stdout 'CTXMARK'
stdout 'systemMessage'
! exec ctxtra doctor
stdout 'schema must be ctxtra/v1 \(found "ctxtra/v9"\)'

# When the binary is gone, the hook command tells the user at session
# start, and answers {} for a subagent. Set up from a copy of the binary,
# then delete the copy.
mkdir bin
exec cp $BIN bin/ctxtra
exec bin/ctxtra setup --agent claude
rm bin/ctxtra
runhook claude SessionStart notes
stdout '^\{"systemMessage":"ctxtra: the ctxtra binary that this hook runs is missing; reinstall ctxtra, or run ctxtra setup --agent claude with the new binary"\}$'
runhook claude SubagentStart notes
stdout '^\{\}$'
! exec ctxtra doctor
stdout 'claude: .*MISSING'
! stderr .
! exec ctxtra context files
stderr '^claude: the hooks run ~/bin/ctxtra, which doesn''t exist; run ctxtra setup --agent claude$'

-- .config/ctxtra/config.yaml --
schema: ctxtra/v1
include: [b.yaml]
-- .config/ctxtra/b.yaml --
schema: ctxtra/v1
bindings:
  - name: me
    match:
      global: true
    instructions: [~/ctx/me.md, ~/ctx/gone.md]
  - name: notes
    match:
      dirs: [~/notes/**]
    instructions: [~/ctx/notes.md]
  - name: repo
    match:
      repos:
        - remote: "**"
    instructions: [~/ctx/repo.md]
-- broken.yaml --
schema: ctxtra/v9
include: [b.yaml]
-- ctx/me.md --
CTXMARK-PERSONAL
-- ctx/notes.md --
CTXMARK-NOTES
-- ctx/repo.md --
CTXMARK-REPO
-- notes/todo.md --
plain folder
