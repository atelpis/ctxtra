# --trust on an imported clone: without --as the source becomes trusted
# under its own name; with --as a separate trusted source is added and the
# pinned one stays.

gitrepo srv/dotfiles
gitrepo srv/team-ctx
exec git clone -q $GITSRV/dotfiles dev/dotfiles
exec git clone -q $GITSRV/team-ctx dev/team-ctx

# Dotfiles imported by mistake, then converted.
exec ctxtra add dev/dotfiles/ctxtra/work.yaml
stdout 'added as source dotfiles'
exec ctxtra add --trust dev/dotfiles/ctxtra/work.yaml
stdout '^converted source dotfiles to trusted-path ~/dev/dotfiles: its files are read from disk now, changes apply right away$'
stdout 'ctxtra://dotfiles/ctxtra/work.yaml is in bindings already'
grep '^    trusted-path: ~/dev/dotfiles$' .config/ctxtra/config.yaml
! grep 'git: .*dotfiles' .config/ctxtra/config.yaml
cp live.md dev/dotfiles/work.md
! exec ctxtra files notes
stdout '^.*/dev/dotfiles/work.md$'
exec ctxtra show notes
stdout 'LIVE-EDIT'

# The team repository: a separate trusted source for editing it live.
exec ctxtra add dev/team-ctx/bindings/billing.yaml
cp live.md dev/team-ctx/services-overview.md
exec ctxtra add --trust dev/team-ctx --as team-ctx-live
stdout '^added source team-ctx-live \(trusted-path: ~/dev/team-ctx\); changes apply right away$'
stdout '^note: ~/dev/team-ctx/... paths in your bindings were served from team-ctx and are now live$'
grep 'git: .*team-ctx' .config/ctxtra/config.yaml
# ctxtra://team-ctx stays pinned; a plain path is now live.
exec ctxtra show notes
stdout 'Contents of .*/.ctxtra/store/.*/services-overview.md'
stdout 'Contents of .*/dev/team-ctx/jira-ticket.md'

-- .config/ctxtra/config.yaml --
apiVersion: ctxtra/v1alpha1
kind: Config
bindings: [bindings.yaml]
-- .config/ctxtra/bindings.yaml --
apiVersion: ctxtra/v1alpha1
kind: Binding
metadata:
  name: me
spec:
  selector:
    global: true
  files: [~/dev/team-ctx/jira-ticket.md]
-- notes/.keep --
-- live.md --
LIVE-EDIT
-- srv/dotfiles/work.md --
work
-- srv/dotfiles/ctxtra/work.yaml --
apiVersion: ctxtra/v1alpha1
kind: Binding
metadata:
  name: work
spec:
  selector:
    global: true
  files: [../work.md]
-- srv/team-ctx/jira-ticket.md --
jira
-- srv/team-ctx/services-overview.md --
overview
-- srv/team-ctx/bindings/billing.yaml --
apiVersion: ctxtra/v1alpha1
kind: Binding
metadata:
  name: billing
spec:
  selector:
    global: true
  files: [../services-overview.md]
