# A clone added as a git source is pinned, starting at the clone's committed
# HEAD. Plain paths under the clone are then served from the source; later
# updates follow the remote.

gitrepo srv/team-ctx
exec git clone -q $GITSRV/team-ctx dev/team-ctx
cp local.md dev/team-ctx/jira-ticket.md
gitcommit dev/team-ctx
exec ctxtra setup --agent claude

exec ctxtra source add git dev/team-ctx --include bindings/billing.yaml
stdout '^~/dev/team-ctx is a clone of https://127.0.0.1:\d+/team-ctx, added as source team-ctx \(pinned\)$'
stdout '^starts at your local commit [0-9a-f]{7}; later updates follow origin/main \(remote not checked yet\)$'
stdout '^included ctxtra://team-ctx/bindings/billing.yaml$'
stdout '^    instructions: services-overview.md$'
stdout 'read it from disk instead: ctxtra source trust team-ctx$'
exec ctxtra source show team-ctx
stdout '^  binding file: ctxtra://team-ctx/bindings/billing.yaml$'
stdout '^  clone: ~/dev/team-ctx '

# Your own binding keeps the plain path; it is served from the store, at
# the committed version. Uncommitted edits are not used.
cp uncommitted.md dev/team-ctx/jira-ticket.md
runhook claude SessionStart notes
stdout 'Contents of .*/.ctxtra/store/.*/jira-ticket.md'
stdout 'LOCAL-COMMIT'
! stdout 'UNCOMMITTED'
stdout 'ctxtra: team-ctx not checked for new commits on this machine yet; run ctxtra source update'
exec ctxtra doctor notes
stdout 'NOTE: ~/dev/team-ctx/jira-ticket.md is served from team-ctx; you can write it as ctxtra://team-ctx/jira-ticket.md'

# Binding files are included all together, or none of them.
! exec ctxtra source add git dev/team-ctx --include bindings/other.yaml --include bindings/missing.yaml
stderr 'bindings/missing.yaml is not a file in the source team-ctx; nothing added'
! grep 'other.yaml' .config/ctxtra/config.yaml

# Another file of the clone is included from the source, at its commit.
exec ctxtra binding-file add dev/team-ctx/bindings/other.yaml
stdout '^included ctxtra://team-ctx/bindings/other.yaml$'
exec ctxtra source add git dev/team-ctx
stdout '^~/dev/team-ctx is a clone of https://.*, the source team-ctx:'

# The clone moves: nothing changes.
mv dev/team-ctx dev/moved
runhook claude SessionStart notes
stdout 'LOCAL-COMMIT'
mv dev/moved dev/team-ctx

# sync follows the remote, which doesn't have the local commit.
stdin no.txt
exec ctxtra-tty source update team-ctx
stdout 'warning: [0-9a-f]{7} doesn''t continue [0-9a-f]{7}'
stdout '^-LOCAL-COMMIT$'

# A local-git source follows the clone's committed HEAD instead.
exec ctxtra source add local-git dev/team-ctx --name team-ctx-dev
stdout '^added source team-ctx-dev \(local-git: ~/dev/team-ctx at [0-9a-f]{7}\); updates follow the clone''s committed HEAD$'
grep '^    local-git: ~/dev/team-ctx$' .config/ctxtra/config.yaml
cp wip.md dev/team-ctx/services-overview.md
gitcommit dev/team-ctx
stdin yes.txt
exec ctxtra-tty source update team-ctx-dev
stdout '^team-ctx-dev: [0-9a-f]{7} -> [0-9a-f]{7} \(local HEAD, ~/dev/team-ctx\)$'
stdout 'accepted team-ctx-dev'
exec ctxtra doctor notes
stdout 'source team-ctx-dev: local-git ~/dev/team-ctx, follows its committed HEAD, pinned to [0-9a-f]{7} \(new commits apply after you accept them in ctxtra source update\), last checked'

# Removing the source: its binding files go, your own references are
# listed, and the clone's old paths are skipped, not read from disk.
exec ctxtra source remove team-ctx --dry-run
stdout '^would remove source team-ctx$'
grep 'ctxtra://team-ctx/' .config/ctxtra/config.yaml
exec ctxtra source remove team-ctx
stdout '^removed source team-ctx$'
stdout '^removed binding file ctxtra://team-ctx/bindings/billing.yaml$'
stdout '^removed binding file ctxtra://team-ctx/bindings/other.yaml$'
stdout '^your bindings still use it:$'
stdout '^  ~/.config/ctxtra/bindings.yaml:\d+  instructions: \[ctxtra://team-ctx/services-overview.md\]$'
stdout '^  ~/.config/ctxtra/bindings.yaml:\d+  instructions: \[~/dev/team-ctx/jira-ticket.md\]$'
! grep 'ctxtra://team-ctx/' .config/ctxtra/config.yaml
! exec ctxtra context files notes
stderr '~/dev/team-ctx/jira-ticket.md: ~/dev/team-ctx was imported as the source team-ctx \(https://.*\), which is not in the config any more; skipped, not read from disk'
! stdout 'jira-ticket.md'

# Removing a binding file, by its entry or its path.
exec ctxtra binding-file remove .config/ctxtra/bindings.yaml --dry-run
stdout '^would remove binding file bindings.yaml$'
symlink cfg -> .config/ctxtra
exec ctxtra binding-file remove cfg/bindings.yaml --dry-run
stdout '^would remove binding file bindings.yaml$'
exec ctxtra binding-file remove bindings.yaml
stdout '^removed binding file bindings.yaml$'
! exec ctxtra binding-file remove bindings.yaml
stderr 'is not in the include list'

-- .config/ctxtra/config.yaml --
schema: ctxtra/v1
include:
  - bindings.yaml
-- .config/ctxtra/bindings.yaml --
schema: ctxtra/v1
bindings:
  - name: me
    match:
      global: true
    instructions: [~/dev/team-ctx/jira-ticket.md]
  - name: team
    match:
      dirs: [~/nowhere]
    instructions: [ctxtra://team-ctx/services-overview.md]
-- notes/.keep --
-- no.txt --
n
-- yes.txt --
y
-- local.md --
LOCAL-COMMIT
-- uncommitted.md --
UNCOMMITTED
-- wip.md --
WIP
-- srv/team-ctx/jira-ticket.md --
REMOTE
-- srv/team-ctx/services-overview.md --
overview
-- srv/team-ctx/bindings/billing.yaml --
schema: ctxtra/v1
bindings:
  - name: billing
    match:
      repos: [{remote: github.com/acme/billing}]
    instructions: [../services-overview.md]
-- srv/team-ctx/bindings/other.yaml --
schema: ctxtra/v1
bindings:
  - name: other
    match:
      repos: [{remote: github.com/acme/other}]
    instructions: [../services-overview.md]
