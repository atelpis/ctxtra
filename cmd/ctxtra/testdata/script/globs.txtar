# Local expansion is shared by bind, previews and hooks.
exec ctxtra binding add local --global --instruction '~/notes/**/*.md'
exec ctxtra context files .
stdout 'notes/a.md'
stdout 'notes/sub/b.md'
exec ctxtra context show .
stdout 'LOCAL_A'
stdout 'LOCAL_B'
! stdout 'EXCLUDED'
exec ctxtra setup --agent claude
runhook claude SessionStart .
stdout 'LOCAL_A'
stdout 'LOCAL_B'

# Entries that start with ! leave files and skills out, wherever they are.
exec ctxtra binding add trimmed --global --instruction '!trim/drafts/**' --instruction 'trim/**/*.md' --skill 'skills/*' --skill '!skills/exp-*'
stdout 'instructions: ''?!~/trim/drafts/\*\*''?, ''?~/trim/\*\*/\*.md'
exec ctxtra context files .
stdout 'trim/kept.md'
! stdout 'drafts'
stdout 'skills/deploy'
! stdout 'exp-x'
exec ctxtra context explain .
stdout 'skip +.*trim/drafts/draft.md \(excluded\)'
stdout 'skip +.*skills/exp-x/SKILL.md \(excluded\)'
runhook claude SessionStart .
stdout 'KEPT'
! stdout 'DRAFT'
! stdout 'Experimental'

# An exclusion that leaves nothing out is a typo, and binding add refuses it.
! exec ctxtra binding add typo --global --instruction 'trim/*.md' --instruction '!trim/kept.mdd'
stderr 'excludes nothing'
! exec ctxtra binding add only --global --instruction '!trim/kept.md'
stderr 'only entries that start with !'

# Pinned patterns must include additions in review without a binding edit.
gitrepo srv/team
exec ctxtra source add git $GITSRV/team --include bindings.yaml
exec ctxtra context show .
stdout 'PINNED_A'
stdout 'OLD_MATCH'
exec ctxtra binding add own --global --instruction 'ctxtra://team/notes/*.md'
rm srv/team/notes/old.md
cp new.md srv/team/notes/new.md
cp old.md srv/team/notes/a.md
gitcommit srv/team
exec ctxtra context show .
! stdout 'NEW_MATCH'
stdin no.txt
exec ctxtra-tty source update
stdout '\+NEW_MATCH'
stdout '\+CHANGED_MATCH'
stdout '-OLD_MATCH'
stdout 'not accepted'
exec ctxtra context show .
! stdout 'NEW_MATCH'
stdin yes.txt
exec ctxtra-tty source update
stdout '\+NEW_MATCH'
exec ctxtra context show .
stdout 'NEW_MATCH'
stdout 'CHANGED_MATCH'

# New glob errors in the user's config must be visible during sync.
exec ctxtra binding add last --global --instruction 'ctxtra://team/notes/new*.md'
rm srv/team/notes/new.md
gitcommit srv/team
stdin no.txt
exec ctxtra-tty source update
stdout 'error: .*ctxtra://team/notes/new\*.md.*glob matches no instructions'
exec ctxtra context show .
stdout 'NEW_MATCH'

-- notes/a.md --
LOCAL_A
-- notes/sub/b.md --
LOCAL_B
-- notes/excluded.txt --
EXCLUDED
-- trim/kept.md --
KEPT
-- trim/drafts/draft.md --
DRAFT
-- skills/deploy/SKILL.md --
---
description: Deploy the service
---
-- skills/exp-x/SKILL.md --
---
description: Experimental
---
-- srv/team/bindings.yaml --
schema: ctxtra/v1
bindings:
  - name: pinned
    match: {global: true}
    instructions: ['notes/**/*.md']
-- srv/team/notes/old.md --
OLD_MATCH
-- srv/team/notes/a.md --
PINNED_A
-- new.md --
NEW_MATCH
-- old.md --
CHANGED_MATCH
-- no.txt --
n
-- yes.txt --
y
