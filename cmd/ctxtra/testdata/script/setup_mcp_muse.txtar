# With MCP servers in the config (experimental), setup adds the ctxtra MCP
# server to .config/muse/settings.json: dry run, add, idempotent, backups, remove.

mkdir .config/ctxtra
cp config.yaml .config/ctxtra/config.yaml
mkdir .config/muse
cp original.json .config/muse/settings.json

# Muse's hooks are in the same file: without the variable, setup adds only
# them.
exec ctxtra setup --agent muse
! grep '"mcpServers"[^}]*"ctxtra"' .config/muse/settings.json
! grep '"mode": "optional"' .config/muse/settings.json

env CTXTRA_EXPERIMENTAL_MCP=1
exec ctxtra setup --dry-run --agent muse
! grep '"mode": "optional"' .config/muse/settings.json

exec ctxtra setup --agent muse
stdout '~/.config/muse/settings.json'
grep '"mode": "optional"' .config/muse/settings.json
exists .ctxtra/backups
exec ctxtra setup --agent muse
stdout 'is already set up for'

exec ctxtra doctor
stdout '    MCP: MCP entry runs .*/ctxtra \(ok\) \(~/.config/muse/settings.json\)'

exec ctxtra setup --remove --agent muse
! grep '"ctxtra":' .config/muse/settings.json
grep '"other"' .config/muse/settings.json

-- config.yaml --
schema: ctxtra/v1
mcp-servers:
  pg: {command: [pg-mcp]}
-- original.json --
{
  "mcpServers": {
    "other": {
      "command": "other-mcp"
    }
  }
}
-- want.json --
{
  "mcpServers": {
    "other": {
      "command": "other-mcp"
    },
    "ctxtra": {
      "type": "stdio",
      "command": "$BIN",
      "args": [
        "mcp",
        "proxy",
        "muse"
      ],
      "mode": "optional"
    }
  }
}
