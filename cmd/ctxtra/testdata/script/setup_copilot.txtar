# Copilot: setup writes its own hook file next to the user's, the hook
# answers with additionalContext, and --remove deletes only its own file.

exec ctxtra setup --agent copilot
stdout '^ctxtra setup \(copilot\): changed$'
cmpenv .copilot/hooks/ctxtra.json want.json
exists .copilot/hooks/other.json

exec ctxtra setup --agent copilot
stdout 'nothing to change'

exec ctxtra doctor
stdout 'copilot: set up for \[sessionStart subagentStart\], runs .*/ctxtra \(ok\)'

runhook copilot sessionStart .
stdout '"additionalContext":"[^"]*CTXMARK-ME'
runhook copilot subagentStart .
stdout 'CTXMARK-ME'

exec ctxtra setup --remove --agent copilot
stdout '^ctxtra setup --remove \(copilot\): changed$'
! exists .copilot/hooks/ctxtra.json
cmp .copilot/hooks/other.json other.json

# With COPILOT_HOME, the hooks go there.
env COPILOT_HOME=$WORK/cphome
exec ctxtra setup --agent copilot
exists cphome/hooks/ctxtra.json

-- .copilot/hooks/other.json --
{"version": 1, "hooks": {"sessionStart": [{"type": "command", "bash": "other-tool"}]}}
-- other.json --
{"version": 1, "hooks": {"sessionStart": [{"type": "command", "bash": "other-tool"}]}}
-- want.json --
{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/bin/sh -c 'f=\"${BIN}\"; if [ -x \"${$}f\" ]; then exec \"${$}f\" hook copilot sessionStart; else /bin/cat >/dev/null 2>&1; echo \"{}\"; fi'",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "/bin/sh -c 'f=\"${BIN}\"; if [ -x \"${$}f\" ]; then exec \"${$}f\" hook copilot subagentStart; else /bin/cat >/dev/null 2>&1; echo \"{}\"; fi'",
        "timeout": 10
      }
    ]
  }
}
-- .config/ctxtra/config.yaml --
apiVersion: ctxtra/v1alpha1
kind: Config
bindings: [b.yaml]
-- .config/ctxtra/b.yaml --
apiVersion: ctxtra/v1alpha1
kind: Binding
metadata: {name: me}
spec: {selector: {global: true}, files: [~/me.md]}
-- me.md --
CTXMARK-ME
