# Secret values: ctxtra mcp add asks for them, stores them encrypted, and
# the proxy gives them only to their own server. No value reaches the
# config, the output, the state files or the log. Tests have no keychain,
# so the key is a file.

env CTXTRA_EXPERIMENTAL_MCP=1
exec ctxtra mcp add --help
stdout '--secret-env NAME'
stdout '--secret-header NAME'
stdout '--client-secret'

# Values from stdin, one per line.
stdin pg.txt
exec ctxtra mcp add pg --secret-env PGPASSWORD --secret-env API_KEY -- mcptest
stdout '^added the MCP server pg to ~/.config/ctxtra/config.yaml: local, mcptest$'
stdout '^stored its secret values, encrypted, in ~/.ctxtra/mcp$'
stderr '^warning: no OS keychain is usable, so the key of ctxtra''s credentials is in ~/.ctxtra/mcp/key: any process of yours can read the credentials$'
stdout '^  pg__env$'
! stdout CTXMARK
! stderr CTXMARK
grep '^    secret-env: \[PGPASSWORD, API_KEY\]$' .config/ctxtra/config.yaml
! grep CTXMARK .config/ctxtra/config.yaml
exists .ctxtra/mcp/credentials/pg.v1.age
! grep CTXMARK .ctxtra/mcp/credentials/pg.v1.age
! grep CTXMARK .ctxtra/mcp/state/pg.json
exec ctxtra mcp list
stdout '^pg  local, secret values set$'

# The proxy gives pg its values, and a server without secret-env none.
exec ctxtra mcp add plain -- mcptest
exec ctxtra binding add work --dir '~/dev/**' --mcp pg --mcp plain
mkdir dev/app
mcp dev/app pg__env
stdout 'PGPASSWORD=CTXMARK-PG-PASSWORD'
stdout 'API_KEY=CTXMARK-API-KEY'
mcp dev/app plain__env
! stdout CTXMARK
exec cat .ctxtra/log.jsonl
stdout '"event":"connect","server":"pg","tools"'
! stdout CTXMARK

# Too few values: nothing changes.
cp .config/ctxtra/config.yaml before.yaml
stdin one.txt
! exec ctxtra mcp add two --secret-env A --secret-env B -- mcptest
stderr 'value of B for two: no value on stdin'
cmp .config/ctxtra/config.yaml before.yaml
! exists .ctxtra/mcp/credentials/two.v1.age

# A remote server's secret header, and the secret of the user's own app.
stdin internal.txt
exec ctxtra mcp add internal https://mcp.internal.example/mcp --secret-header Authorization --client-id app --client-secret --no-login
stdout 'stored its secret values'
grep '^    secret-headers: \[Authorization\]$' .config/ctxtra/config.yaml
grep '^    client-id: app$' .config/ctxtra/config.yaml
! grep CTXMARK .config/ctxtra/config.yaml
! exec ctxtra mcp add web https://example.com/mcp --client-secret --no-login
stderr '--client-secret needs --client-id'

# Without its values in the store, pg is left out, and the log says why.
cp .ctxtra/mcp/credentials/pg.v1.age pg.age
rm .ctxtra/mcp/credentials/pg.v1.age
mcp dev/app
! stdout 'tool pg__'
stdout 'tool plain__echo'
exec cat .ctxtra/log.jsonl
stdout '"server":"pg",.*"error":"secret values are not available: pg: its secret values are not set; run ctxtra mcp login pg"'
cp pg.age .ctxtra/mcp/credentials/pg.v1.age

# login asks for the values again, and replaces them.
stdin newpg.txt
exec ctxtra mcp login pg
stdout '^stored the secret values of pg$'
mcp dev/app pg__env
stdout 'PGPASSWORD=CTXMARK-NEW-PASSWORD'
! stdout 'CTXMARK-PG-PASSWORD'

# remove deletes the server's credentials, and only its own.
exec ctxtra mcp remove pg
! exists .ctxtra/mcp/credentials/pg.v1.age
! exists .ctxtra/mcp/state/pg.json
exists .ctxtra/mcp/credentials/internal.v1.age

-- pg.txt --
CTXMARK-PG-PASSWORD
CTXMARK-API-KEY
-- newpg.txt --
CTXMARK-NEW-PASSWORD
CTXMARK-NEW-KEY
-- one.txt --
CTXMARK-A
-- internal.txt --
Bearer CTXMARK-TOKEN
CTXMARK-CLIENT-SECRET
